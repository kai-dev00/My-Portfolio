# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# Restart `npm run dev` after changing it.

# The Gmail account that sends the contact-form emails
GMAIL_USER=
# A Google "App Password" (16 characters), NOT your normal Gmail password
GMAIL_APP_PASSWORD=
# Where messages are delivered. Optional: defaults to GMAIL_USER
CONTACT_TO=
